# --- Piccolo configuration -------------------------------------------------
# Port the app listens on inside the container
PORT=8080
HOST=0.0.0.0

# Public base URL, used to build the QR code / join link shown on the host screen.
# Set this to whatever your friends will type on their phones.
PUBLIC_URL=http://localhost:8080

# Room settings
ROOM_MAX_PLAYERS=16
ROOM_IDLE_TIMEOUT_MINUTES=90

# Set to "true" to allow the 18+ decks to be unlockable on this instance at all.
# If false, the toggle is hidden everywhere. Handy for a family instance.
ALLOW_ADULT_CONTENT=true

# Optional: gate the whole instance behind a shared password (leave empty to disable)
INSTANCE_PASSWORD=

# Password for the /admin page, where you can read every game's cards, questions
# and answers in both languages. Leave empty and the page stays disabled.
ADMIN_PASSWORD=admin
